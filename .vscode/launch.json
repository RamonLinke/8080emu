{
    "version": "0.2.0",
    "configurations": [
            {
            "name": "debug",
            "preLaunchTask": "install-debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/emulator",
            "args": ["${workspaceFolder}/test/TST8080.COM"],
            "cwd": "${workspaceFolder}/build/Debug",
            "externalConsole": false,

            "linux": {
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": false
                    }
                ]
            },
        },
        {
            "name": "debug tests",
            "preLaunchTask": "build-debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/emulator_tests",
            "args": ["--gtest_filter=${input:gtestFilter}", "--gtest_break_on_failure"],
            "cwd": "${workspaceFolder}/build/Debug",
            "externalConsole": false,

            "linux": {
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": false
                    }
                ]
            },
        },
    ],
    "inputs": [
        {
            "id": "gtestFilter",
            "type": "promptString",
            "description": "Tests to run (gtest filter, e.g. AluTest.* or *DAA*)",
            "default": "*"
        }
    ]
}
